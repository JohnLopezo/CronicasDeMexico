  branches:
  - requiredFlags:
    - mision.MP_OLM_02.completada
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "\xBFUna entrada en la selva? Con raz\xF3n los caminos est\xE1n tan raros.
        Yo me quedo junto al r\xEDo."
    flagsOnFinish: []
    questToStart: {fileID: 0}
  - requiredFlags: []
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Traigo obsidiana, conchas y piedra verde de muy lejos... o tra\xEDa.
        Los caminos ya no son seguros."
    - speaker: {fileID: 0}
      text: "Antes sab\xEDa cada vuelta del camino. Ahora llego a un cruce y no recuerdo
        hacia d\xF3nde iba."
    - speaker: {fileID: 0}
      text: "Cuando vuelvan a ser seguros, tendr\xE9 buenas cosas que cambiar."
    flagsOnFinish: []
    questToStart: {fileID: 0}
