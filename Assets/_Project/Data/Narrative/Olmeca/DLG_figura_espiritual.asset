MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a33fe671ef33db241a91794b922ee781, type: 3}
  m_Name: DLG_figura_espiritual
  m_EditorClassIdentifier: 
  branches:
  - requiredFlags:
    - olm.juramento
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Ve al asentamiento. Busca al artesano de jade: sus manos todav\xEDa
        recuerdan."
    flagsOnFinish: []
    questToStart: {fileID: 0}
  - requiredFlags: []
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "No intentes hablar. Aqu\xED no hace falta la voz para que te escuche."
    - speaker: {fileID: 0}
      text: "Has llegado al Mundo de las Memorias. Aqu\xED permanecen los ecos de
        los pueblos: sus caminos, sus relatos, lo que supieron."
    - speaker: {fileID: 0}
      text: "No soy un dios, ni vengo a hacerte da\xF1o. Solo esperaba a alguien
        que pudiera ver este mundo desde fuera de sus \xE9pocas."
    - speaker: {fileID: 0}
      text: "Las memorias se est\xE1n deshaciendo. Las estelas enmudecen, los caminos
        se borran y hay criaturas que ya no reconocen a nadie."
    - speaker: {fileID: 0}
      text: "Tu forma es la del jaguar. Con ella cruzar\xE1s la selva."
    - speaker: {fileID: 0}
      text: "Cerca de aqu\xED hay un asentamiento. Sus guardianes han dejado de responder.
        Ve, escucha a su gente y averigua por qu\xE9."
    flagsOnFinish:
    - olm.juramento
    questToStart: {fileID: 0}
