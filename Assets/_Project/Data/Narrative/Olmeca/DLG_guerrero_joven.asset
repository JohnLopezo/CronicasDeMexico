  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a33fe671ef33db241a91794b922ee781, type: 3}
  m_Name: DLG_guerrero_joven
  m_EditorClassIdentifier: 
  branches:
  - requiredFlags:
    - olm.guerrero_en_selva
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: Sal de la plaza por el sendero del oeste, el que se mete entre las palmas.
        Te alcanzo en la entrada.
    flagsOnFinish: []
    questToStart: {fileID: 0}
  - requiredFlags:
    - olm.anciana_conto
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "No me mires as\xED. Es solo un rasgu\xF1o... bueno, uno grande."
    - speaker: {fileID: 0}
      text: "Fuimos tres a revisar los caminos de la selva. Los animales no hu\xEDan
        de nosotros: nos esperaban."
    - speaker: {fileID: 0}
      text: "Ten\xEDan algo raro. Grietas que brillaban en la piel, como si les faltaran
        pedazos."
    - speaker: {fileID: 0}
      text: "M\xE1s all\xE1 de las ceibas, entre las ra\xEDces, encontr\xE9 una entrada
        de piedra que no recordaba. Y conozco bien esa parte de la selva."
    - speaker: {fileID: 0}
      text: "\xBFVas a ir? Entonces sal de la plaza por el sendero del oeste. Cuando
        ca\xEDan, esas criaturas dejaban una piedrecita con luz. Yo no me atrev\xED
        a tocarlas."
    - speaker: {fileID: 0}
      text: Te alcanzo en la entrada. Conozco un atajo, aunque sea cojeando.
    flagsOnFinish:
    - olm.guerrero_en_selva
    questToStart: {fileID: 11400000, guid: c4617763dfcdcd045905b1c871019ea2, type: 2}
  - requiredFlags: []
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Me dijeron que descansara. Descansar es m\xE1s dif\xEDcil que pelear."
    flagsOnFinish: []
    questToStart: {fileID: 0}
