MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a33fe671ef33db241a91794b922ee781, type: 3}
  m_Name: DLG_guerrero_joven_entrada
  m_EditorClassIdentifier: 
  branches:
  - requiredFlags:
    - mision.MP_OLM_03.completada
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Yo vigilo aqu\xED afuera. Lo que borra las piedras est\xE1 ah\xED abajo,
        y t\xFA eres quien puede entrar."
    flagsOnFinish: []
    questToStart: {fileID: 0}
  - requiredFlags:
    - olm.selva.fragmento_1
    - olm.selva.fragmento_2
    - olm.selva.fragmento_3
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Llegaste. Y traes esas piedrecitas con luz... \xBFlas sientes? Son pedazos
        de algo que alguien record\xF3."
    - speaker: {fileID: 0}
      text: "Mira las columnas: son de basalto, como las del recinto de la plaza.
        Mi abuela dec\xEDa que bajo los mont\xEDculos as\xED descansaba alguien importante."
    - speaker: {fileID: 0}
      text: "Pero yo crec\xED en esta selva y nunca vi esta entrada. No estaba aqu\xED...
        o no la record\xE1bamos."
    - speaker: {fileID: 0}
      text: "Algo all\xE1 abajo se est\xE1 comiendo los recuerdos. Si alguien puede
        detenerlo, es quien vino de fuera."
    flagsOnFinish: []
    questToStart: {fileID: 0}
  - requiredFlags: []
    forbiddenFlags: []
    lines:
    - speaker: {fileID: 0}
      text: "Aqu\xED es, entre las ra\xEDces. Llegu\xE9 antes que t\xFA: conozco
        los atajos."
    - speaker: {fileID: 0}
      text: "No entres todav\xEDa. Las criaturas corrompidas siguen en el sendero,
        y lo que dejan al caer hay que recogerlo antes de que se apague."
    flagsOnFinish: []
    questToStart: {fileID: 0}
