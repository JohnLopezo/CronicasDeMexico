  m_Script: {fileID: 11500000, guid: fc13ef35f7805e74292cde5bab3e2097, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: Examinar
  text: Una estela de basalto. Si tuvo relieves, la lluvia y el tiempo los borraron.
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: estela
  alternateFlag: mision.MP_OLM_02.completada
  alternateText: "Una estela de basalto. Desde que el artesano lo dijo, no puedes
    dejar de notarlo: la piedra no est\xE1 gastada como las rocas del camino. Est\xE1
    lisa, como si las marcas nunca hubieran existido."
