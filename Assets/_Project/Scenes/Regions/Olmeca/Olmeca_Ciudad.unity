  m_Name: 
  m_EditorClassIdentifier: 
  prompt: Examinar
  text: "Un altar-trono de basalto. En La Venta, de nichos como este sale la figura
    de un gobernante sentado (Altar 4). Este nicho est\xE1 vac\xEDo."
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: altar_trono
  alternateFlag: olm.anciana_recordo
  alternateText: En el nicho del altar-trono brilla el Fragmento de la Primera Memoria.
    Al tocarlo, por un instante, toda la plaza recuerda lo que fue.
