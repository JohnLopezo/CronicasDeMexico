    de caer.\nTe asomas al agua. Quieres hablar y solo sale un gru\xF1ido. En el
    reflejo no hay una persona: te mira un jaguar."
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: reflejo
  alternateFlag: 
  alternateText: 
