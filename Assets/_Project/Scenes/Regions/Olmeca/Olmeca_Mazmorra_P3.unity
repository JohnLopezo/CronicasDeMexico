  m_Script: {fileID: 11500000, guid: 69268537697553b479e4ba097cbb171c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: Empujar la losa
  text: "Una estela de basalto, puesta como losa, tapa un p\xF3rtico en el muro.
    De su base salen grietas violetas, como ra\xEDces. Del otro lado algo respira
    despacio, y es la piedra misma. Empujas: la losa cede, rechinando, y se hunde
    en el suelo."
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: sello_guardian
  openFlag: olm.sello_abierto
