  - {fileID: 311264930}
  displayName: "Guardi\xE1n de la Piedra Viva"
  bossNameChannel: {fileID: 11400000, guid: f0063337a774cba468e0acdc1ac7fac6, type: 2}
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  defeatText: "La Piedra Viva se detiene. Las grietas violetas se cierran como heridas
    que sanan, el disco de su pecho se vuelve verde y la figura se sienta, despacio,
    como si recordara c\xF3mo hacerlo. Te habla sin voz: \xABGuardaba la primera
    memoria de esta tierra. La sombra me hizo ver en ti a quien ven\xEDa a robarla.\xBB
    Por un instante ves la plaza llena de gente y el r\xEDo cargando basalto. Luego,
    silencio."
  engageRadius: 6
  moveSpeed: 1.6
  attackCooldown: 1
  baseWindup: 0.6
  gravity: -20
  heavyDamage: 20
  lightDamage: 10
  chargeSpeed: 11
  chargeLength: 8
  chargeStun: 1.6
  roarKnockback: 9
  shardSpeed: 6
