  m_Name: 
  m_EditorClassIdentifier: 
  prompt: Examinar
  text: "Columnas de basalto ca\xEDdas, partidas por grietas que brillan como brasas.
    Detr\xE1s se adivina un hueco. La piedra no cede a los golpes: har\xEDa falta
    que la tierra misma la empujara."
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: 
  alternateFlag: 
  alternateText: 
