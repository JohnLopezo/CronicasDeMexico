  moveSpeed: 1.6
  attackCooldown: 1
  baseWindup: 0.6
  gravity: -20
  heavyDamage: 20
  lightDamage: 10
  chargeSpeed: 11
  chargeLength: 8
  chargeStun: 1.6
  roarKnockback: 9
