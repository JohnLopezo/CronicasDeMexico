  m_Script: {fileID: 11500000, guid: d3b6a120be50afa459cf14fe7901e6d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: Recoger
  text: "Un fragmento de memoria, tibio como una piedra al sol. Al tocarlo oyes voces
    que cantan mientras arrastran una piedra enorme r\xEDo abajo, desde monta\xF1as
    que no conoces."
  messageChannel: {fileID: 11400000, guid: 40479bdc95cd83c49b8e1e2d4a300ec4, type: 2}
  examineId: fragmento_menor
  collectedFlag: olm.selva.fragmento_1
